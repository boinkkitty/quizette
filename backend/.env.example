# Backend settings. Copy to .env.local (git-ignored): cp .env.example .env.local
# `make dev` loads .env.local. In production (Render), set these as service env vars instead.

# ---- Required (no defaults; the API refuses to start without them) ----
# development | test | production
APP_ENV=development
# API listen port. Render sets this automatically.
PORT=8080
# Browser-facing origin: the Vite dev server locally, the Cloudflare Worker in production.
PUBLIC_URL=http://localhost:5173
# Matches the dev Postgres in docker-compose.yml. Use the Neon pooled URL in production.
DATABASE_URL=postgres://quizette:quizette@localhost:5432/quizette?sslmode=disable

# ---- LLM ----
# gemini | stub (stub = deterministic questions, no key needed; not allowed in production)
LLM_PROVIDER=stub
STUB_LLM_DELAY=3s
# Required when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# pdf-native | text-extract
GENERATION_STRATEGY=pdf-native
# GEMINI_THINKING_BUDGET=0

# ---- Tunables (defaults shown) ----
# debug | info | warn | error
LOG_LEVEL=info
DAILY_UPLOAD_LIMIT=10
JOB_WORKERS=2
JOB_QUEUE_SIZE=20
JOB_TIMEOUT=3m

# ---- OAuth (optional; a provider is enabled when its client ID is set) ----
# Redirect URIs: $PUBLIC_URL/api/auth/google/callback and $PUBLIC_URL/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
