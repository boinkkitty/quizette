# Backend settings. Copy to .env.local (git-ignored): cp .env.example .env.local
# `make dev` loads .env.local. In production (Render), set these as service env vars instead.

# ---- Required (no defaults; the API refuses to start without them) ----
# development | test | production
APP_ENV=development
# API listen port. Render sets this automatically.
PORT=8080
# Browser-facing origin: the Vite dev server locally, the Cloudflare Worker in production.
PUBLIC_URL=http://localhost:5173
# Matches the dev Postgres in docker-compose.yml. Use the Neon pooled URL in production.
DATABASE_URL=postgres://quizette:quizette@localhost:5432/quizette?sslmode=disable

# ---- LLM ----
# gemini | openrouter | stub (stub = deterministic questions, no key needed; not allowed in production)
LLM_PROVIDER=stub
STUB_LLM_DELAY=3s
# Required when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when GEMINI_MODEL fails with HTTP 408, 429 or 5xx. "none" disables fallback.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# pdf-native | text-extract
GENERATION_STRATEGY=pdf-native
# GEMINI_THINKING_BUDGET=0

# ---- OpenRouter (optional backup provider; see docs/adr/0008) ----
# With LLM_PROVIDER=gemini, setting a key makes OpenRouter the backup when every Gemini model is busy.
# With LLM_PROVIDER=openrouter, it is the only provider (no Gemini key needed). Key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Comma-separated; tried in order by OpenRouter. List only ":free" models: a fallback to a paid model is billed.
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free
# PDF parser for GENERATION_STRATEGY=pdf-native. cloudflare-ai is free; mistral-ocr is paid.
OPENROUTER_PDF_ENGINE=cloudflare-ai
# Time each provider gets before the next one is tried (the last gets what remains of JOB_TIMEOUT).
LLM_ATTEMPT_TIMEOUT=90s

# ---- Tunables (defaults shown) ----
# debug | info | warn | error
LOG_LEVEL=info
JOB_WORKERS=2
JOB_QUEUE_SIZE=20
JOB_TIMEOUT=3m

# ---- OAuth (optional; a provider is enabled when its client ID is set) ----
# Redirect URIs: $PUBLIC_URL/api/auth/google/callback and $PUBLIC_URL/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
