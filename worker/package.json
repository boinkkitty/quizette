{
  "name": "quizette-worker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --dir ../frontend build",
    "dev": "node scripts/wrangler.mjs dev",
    "deploy": "pnpm build && node scripts/wrangler.mjs deploy",
    "test": "node --test scripts/wrangler.test.mjs test/proxy.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "pnpm build && node scripts/wrangler.mjs versions upload"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  }
}
