# E2E settings. Copy to .env.local (git-ignored): cp .env.example .env.local
# Playwright starts the Go API and the Vite dev server on these ports.

# Matches the dev Postgres in docker-compose.yml.
DATABASE_URL=postgres://quizette:quizette@localhost:5432/quizette?sslmode=disable
E2E_API_PORT=8080
E2E_WEB_PORT=5173
