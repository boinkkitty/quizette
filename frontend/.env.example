# Frontend dev-server settings. Copy to .env.local (git-ignored): cp .env.example .env.local
# Used only by vite.config.ts for `pnpm dev`; production builds don't need them.

# Port the Vite dev server listens on. Must match the backend's PUBLIC_URL.
DEV_PORT=5173
# Where /api requests are proxied. Must match the backend's PORT.
API_PROXY_TARGET=http://localhost:8080
